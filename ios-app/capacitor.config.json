{
  "appId": "biz.ontimetaxi.app",
  "appName": "On Time Taxi",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://ontimetaxi.biz",
    "cleartext": false,
    "allowNavigation": [
      "ontimetaxi.biz",
      "*.ontimetaxi.biz",
      "*.mapbox.com",
      "*.supabase.co",
      "*.stripe.com",
      "js.stripe.com",
      "checkout.stripe.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0b1020",
      "showSpinner": false
    },
    "Geolocation": {}
  }
}
